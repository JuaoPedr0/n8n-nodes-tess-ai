{
	"type": "object",
	"properties": {
		"total_links": {
			"type": "integer",
			"minimum": 1,
			"description": "Quantidade de links recebidos"
		},
		"noticias": {
			"type": "array",
			"minItems": 1,
			"description": "Uma análise por link, na ordem recebida",
			"items": { "$ref": "#/$defs/noticia" }
		},
		"teor_predominante": {
			"type": "string",
			"enum": ["positivo", "negativo", "neutro", "misto", "indeterminado"]
		},
		"panorama_geral": {
			"type": "string",
			"minLength": 20,
			"description": "3 a 5 frases relacionando as notícias"
		}
	},
	"required": ["total_links", "noticias", "teor_predominante", "panorama_geral"],
	"$defs": {
		"noticia": {
			"type": "object",
			"properties": {
				"url": { "type": "string", "format": "uri" },
				"acessivel": { "type": "boolean", "description": "false se o link não abriu ou não é notícia" },
				"titulo": { "type": ["string", "null"] },
				"veiculo": { "type": ["string", "null"] },
				"data_publicacao": { "type": ["string", "null"], "format": "date", "description": "AAAA-MM-DD" },
				"resumo": { "type": "string", "minLength": 10 },
				"teor": {
					"type": "string",
					"enum": ["positivo", "negativo", "neutro", "misto", "indeterminado"]
				},
				"tema_principal": { "type": ["string", "null"] },
				"pontos_chave": {
					"type": "array",
					"maxItems": 5,
					"items": { "type": "string" }
				},
				"entidades": {
					"type": "array",
					"items": { "type": "string" }
				},
				"relevancia": { "type": "integer", "minimum": 1, "maximum": 5 },
				"confianca": { "type": "number", "minimum": 0, "maximum": 1 }
			},
			"required": [
				"url",
				"acessivel",
				"titulo",
				"veiculo",
				"data_publicacao",
				"resumo",
				"teor",
				"tema_principal",
				"pontos_chave",
				"entidades",
				"relevancia",
				"confianca"
			]
		}
	}
}
