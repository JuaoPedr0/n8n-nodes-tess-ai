			"alwaysOutputData": true,
			"onError": "continueRegularOutput"
		},
		{
			"parameters": {
				"jsCode": "// Registra o horario em que a chamada a Tess terminou (e se deu erro)\nconst cur = $('Loop Over Items').first().json;\nconst out = $input.first()?.json || {};\nconst err = out.error ? String(out.error) : '';\nreturn [{\n  json: {\n    run_id: cur.run_id,\n    worker: cur.worker,\n    seq: cur.seq,\n    at_ms: Date.now(),\n    status: err ? 'error' : 'ok',\n    error: err.slice(0, 300),\n  },\n}];"
			},
			"id": "8d1a2f6e-0c11-4a7e-9b41-0f3a6c1e0a05",
