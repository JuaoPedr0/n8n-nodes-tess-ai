		{
			"parameters": {
				"jsCode": "// Gera N chamadas para este worker (vindas do orquestrador)\nconst b = $input.first().json.body || {};\nconst calls = Math.max(1, Number(b.calls) || 5);\nreturn Array.from({ length: calls }, (_, i) => ({\n  json: { run_id: String(b.run_id || 'manual'), worker: String(b.worker || 'W?'), seq: i + 1 },\n}));"
			},
			"id": "8d1a2f6e-0c11-4a7e-9b41-0f3a6c1e0a02",
